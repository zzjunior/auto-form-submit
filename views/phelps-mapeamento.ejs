<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Mapeamento de Campos - Phelps</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css?family=Poppins:400,500,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <style>
    body, .form-label, .btn, input, label, small, a {
      font-family: 'Poppins', Arial, sans-serif !important;
    }
    .sidebar {
      height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
      width: 200px;
      background: #fff;
      border-right: 1px solid #eee;
      padding-top: 60px;
      z-index: 1030;
      box-shadow: 2px 0 8px rgba(0,0,0,0.03);
      transition: width 0.2s;
    }
    .sidebar.collapsed {
      width: 60px;
    }
    .sidebar .nav-link {
      color: #333;
      font-weight: 500;
      padding: 12px 24px;
      display: block;
      transition: background 0.2s, padding 0.2s, opacity 0.2s;
    }
    .sidebar .nav-link .sidebar-label {
      display: inline;
    }
    .sidebar.collapsed .nav-link .sidebar-label {
      display: none;
    }
    .sidebar .nav-link i {
      margin-left: 8px;
      font-size: 1.2em;
    }
    .sidebar.collapsed .nav-link {
      text-align: center;
      padding-left: 0;
      padding-right: 0;
    }
    .sidebar.collapsed .nav-link i {
      margin-left: 0;
      font-size: 1.5em;
    }
    .sidebar .nav-link:hover {
      background: #f8f9fa;
      color: #0d6efd;
      text-decoration: none;
    }
    .sidebar-toggle {
      position: absolute;
      top: 10px;
      right: -20px;
      background: #fff;
      border: 1px solid #eee;
      border-radius: 50%;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 1050;
      box-shadow: 0 2px 8px rgba(0,0,0,0.07);
      transition: right 0.2s;
      font-size: 1.5rem;
      color: #333;
    }
    .sidebar-toggle .toggle-icon {
      font-size: 1.5rem;
      font-weight: bold;
      color: #333;
      transition: transform 0.2s;
      display: inline-block;
    }
    .sidebar.collapsed .sidebar-toggle .toggle-icon {
      transform: rotate(180deg);
    }
    .sidebar.collapsed + .main-content {
      margin-left: 60px;
    }
    @media (max-width: 768px) {
      .sidebar {
        width: 100%;
        height: auto;
        position: static;
        border-right: none;
        box-shadow: none;
        padding-top: 0;
      }
      .sidebar.collapsed {
        width: 100%;
      }
      .main-content {
        margin-left: 0 !important;
      }
    }
    .main-content {
      margin-left: 200px;
      transition: margin-left 0.2s;
    }
  </style>
</head>
<body class="bg-light">
  <!-- Sidebar -->
  <nav class="sidebar d-flex flex-column" id="sidebar">
    <button class="sidebar-toggle" id="sidebarToggle" title="Encolher/Expandir">
      <span class="toggle-icon">&lt;</span>
    </button>
    <a href="/" class="nav-link">
      <span class="sidebar-label">Início</span>
      <i class="fa-solid fa-house-chimney"></i>
    </a>
    <a href="/phelps" class="nav-link">
      <span class="sidebar-label">PHELPS</span>
      <i class="fa-solid fa-person-swimming"></i>
    </a>
    <a href="/logout" class="nav-link">
      <span class="sidebar-label">Sair</span>
      <i class="fa-solid fa-right-from-bracket"></i>
    </a>
  </nav>
  <!-- Main Content -->
  <div class="main-content">
    <div class="container py-5">
      <div class="row justify-content-center">
        <div class="col-md-8">
          <div class="card shadow">
            <div class="card-body">
              <h5 class="card-title mb-4 text-center">Mapeamento dos Campos da Planilha - Phelps</h5>
              <form id="form-phelps-process" action="/phelps/processar" method="post">
                <div class="row">
                  <% camposFormulario.forEach(function(campo) { %>
                    <div class="col-md-6 mb-3">
                      <label class="form-label"><%= campo.label %></label>
                      <select name="<%= campo.name %>" class="form-select" required>
                        <option value="">Selecione a coluna</option>
                        <% colunas.forEach(function(col) { %>
                          <option value="<%= col %>"><%= col %></option>
                        <% }) %>
                      </select>
                    </div>
                  <% }) %>
                </div>
                <button type="submit" class="btn btn-primary w-100 mt-3">Processar</button>
              </form>

              <!-- Histórico de planilhas processadas -->
              <div class="mt-4">
                <h6 class="text-black-50 mb-2"><i class="fa-solid fa-clock-rotate-left"></i> Histórico Phelps</h6>
                <ul class="list-group" id="historicoPhelps">
                  <!-- Preenchido via JS -->
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <footer class="bg-white text-center py-3 mt-5 shadow-sm"
      style="position:fixed;left:0;bottom:0;width:100%;z-index:1040;">
      <div class="container">
        <small class="text-muted text-decoration-none">&copy; 2025 <a href="https://github.com/zzjunior">zzjunior</a></small>
      </div>
    </footer>
  </div>

  <!-- Modal Bootstrap -->
  <div class="modal fade" id="phelpsModal" tabindex="-1" aria-labelledby="phelpsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="phelpsModalLabel">Resultado do Processamento Phelps</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body" id="phelpsModalBody">
          <!-- Conteúdo preenchido via JS -->
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-danger" id="btnStopPhelps" style="display:none;">Parar de processar</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const sidebar = document.getElementById('sidebar');
    const sidebarToggle = document.getElementById('sidebarToggle');
    sidebarToggle.addEventListener('click', function() {
      sidebar.classList.toggle('collapsed');
    });

    let isProcessingPhelps = false;
    let currentExecutionId = null;
    let progressInterval = null;

    // Processa formulário Phelps
    document.getElementById('form-phelps-process').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      if (isProcessingPhelps) {
        console.log('Já está processando Phelps, ignorando submit duplicado');
        return;
      }
      
      isProcessingPhelps = true;
      const form = e.target;
      const formData = new FormData(form);

      // DEBUG MAIS DETALHADO
      console.log('=== DEBUG FRONTEND PHELPS ===');
      console.log('Form element:', form);
      console.log('FormData entries:');
      for (let [key, value] of formData.entries()) {
        console.log(`${key}: "${value}"`);
      }
      
      // Converte FormData para objeto para debug
      const mapeamentoObj = Object.fromEntries(formData.entries());
      console.log('Mapeamento como objeto:', mapeamentoObj);

      // Verifica se todos os campos obrigatórios foram mapeados
      const camposObrigatorios = ['nome_completo', 'CPF', 'name', 'slug'];
      let camposSemMapeamento = [];
      
      camposObrigatorios.forEach(campo => {
        const valor = formData.get(campo);
        if (!valor) {
          camposSemMapeamento.push(campo);
        }
      });

      if (camposSemMapeamento.length > 0) {
        alert(`Os seguintes campos obrigatórios não foram mapeados: ${camposSemMapeamento.join(', ')}`);
        isProcessingPhelps = false;
        return;
      }

      const modal = new bootstrap.Modal(document.getElementById('phelpsModal'));
      const modalBody = document.getElementById('phelpsModalBody');
      const btnStop = document.getElementById('btnStopPhelps');
      
      btnStop.style.display = 'inline-block';
      modalBody.innerHTML = `
        <div class="text-center mb-3" id="phelpsSpinner">
          <div class="spinner-border"></div>
          <div>Iniciando processamento Phelps...</div>
        </div>
        <div class="progress mb-3">
          <div class="progress-bar" role="progressbar" style="width: 0%" id="progressBar">0%</div>
        </div>
        <div id="statusText">Preparando...</div>
        <ul class="list-group mt-3" id="phelpsProcessList"></ul>
      `;
      modal.show();

      try {
        const response = await fetch('/phelps/processar', {
          method: 'POST',
          body: formData
        });
        const result = await response.json();

        if (result.status === 'iniciado') {
          currentExecutionId = result.executionId;
          document.getElementById('statusText').textContent = `Processando ${result.total} linhas...`;
          
          // Configura botão de parar
          btnStop.onclick = async function() {
            btnStop.disabled = true;
            btnStop.innerText = "Parando...";
            
            await fetch(`/phelps/parar/${currentExecutionId}`, { method: 'POST' });
          };

          // Inicia monitoramento do progresso
          progressInterval = setInterval(async () => {
            try {
              const progressResponse = await fetch(`/phelps/progresso/${currentExecutionId}`);
              const progress = await progressResponse.json();
              
              if (progress.status === 'nao_encontrado') {
                clearInterval(progressInterval);
                return;
              }

              // Atualiza barra de progresso
              const progressBar = document.getElementById('progressBar');
              progressBar.style.width = `${progress.progresso}%`;
              progressBar.textContent = `${progress.progresso}%`;
              
              // Atualiza status
              document.getElementById('statusText').textContent = 
                `Processadas: ${progress.processadas}/${progress.total} (${progress.progresso}%)`;

              // Atualiza lista de resultados
              const processList = document.getElementById('phelpsProcessList');
              processList.innerHTML = progress.resultados.map(r =>
                `<li class="list-group-item list-group-item-${r.status === 'sucesso' ? 'success' : 'danger'}">
                  Linha ${r.linha}: ${r.nome} - ${r.status === 'sucesso' ? r.mensagem : 'Erro: ' + r.mensagem}
                </li>`
              ).join('');

              // Verifica se terminou
              if (progress.status === 'finalizado' || progress.status === 'parado' || progress.status === 'erro') {
                clearInterval(progressInterval);
                progressInterval = null;
                btnStop.style.display = 'none';
                isProcessingPhelps = false;
                
                if (progress.status === 'finalizado') {
                  document.getElementById('statusText').innerHTML = 
                    `<div class="alert alert-success">Processamento concluído! ${progress.processadas}/${progress.total} linhas processadas.</div>`;
                } else if (progress.status === 'parado') {
                  document.getElementById('statusText').innerHTML = 
                    `<div class="alert alert-warning">Processamento interrompido! ${progress.processadas}/${progress.total} linhas processadas.</div>`;
                } else {
                  document.getElementById('statusText').innerHTML = 
                    `<div class="alert alert-danger">Erro no processamento: ${progress.erro}</div>`;
                }

                // Salva no histórico
                salvarHistoricoPhelps(formData);
              }
            } catch (err) {
              console.error('Erro ao verificar progresso:', err);
            }
          }, 2000); // Verifica a cada 2 segundos

        } else {
          btnStop.style.display = 'none';
          modalBody.innerHTML = `<div class="alert alert-danger">Erro ao iniciar: ${result.mensagem}</div>`;
          isProcessingPhelps = false;
        }
      } catch (err) {
        btnStop.style.display = 'none';
        modalBody.innerHTML = `<div class="alert alert-danger">Erro ao processar: ${err.message}</div>`;
        isProcessingPhelps = false;
      }
    });

    // Funções do histórico Phelps
    function carregarHistoricoPhelps() {
      const historico = JSON.parse(localStorage.getItem('historicoPhelps') || '[]');
      const ul = document.getElementById('historicoPhelps');
      ul.innerHTML = '';
      if (historico.length === 0) {
        ul.innerHTML = '<li class="list-group-item text-muted">Nenhuma planilha Phelps processada ainda.</li>';
      } else {
        historico.forEach((item, idx) => {
          ul.innerHTML += `
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span>
                <i class="fa-solid fa-person-swimming text-primary"></i>
                <b>Phelps - ${item.dataHora}</b>
              </span>
              <button class="btn btn-outline-primary btn-sm" onclick="reprocessarPhelps(${idx})">
                <i class="fa-solid fa-rotate-right"></i> Reprocessar
              </button>
            </li>
          `;
        });
      }
    }

    function salvarHistoricoPhelps(formData) {
      const historico = JSON.parse(localStorage.getItem('historicoPhelps') || '[]');
      historico.unshift({
        dataHora: new Date().toLocaleString(),
        mapeamento: Object.fromEntries(formData.entries())
      });
      localStorage.setItem('historicoPhelps', JSON.stringify(historico.slice(0, 10)));
      carregarHistoricoPhelps();
    }

    window.reprocessarPhelps = function(idx) {
      const historico = JSON.parse(localStorage.getItem('historicoPhelps') || '[]');
      const item = historico[idx];
      if (!item) return;
      
      // Preenche os selects com o mapeamento salvo
      for (const [campo, coluna] of Object.entries(item.mapeamento)) {
        const select = document.querySelector(`select[name="${campo}"]`);
        if (select) {
          select.value = coluna;
        }
      }
      
      alert('Mapeamento restaurado! Faça novo upload da planilha e clique em Processar.');
    };

    carregarHistoricoPhelps();
  </script>
</body>
</html>
