<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bot Auto Cadastro - SheatsBot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css?family=Poppins:400,500,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <style>
    body, .card, .form-label, .btn, .card-title, .text-black-50, .text-muted, input, label, small, a {
      font-family: 'Poppins', Arial, sans-serif !important;
    }
    .sidebar {
      height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
      width: 200px;
      background: #fff;
      border-right: 1px solid #eee;
      padding-top: 60px;
      z-index: 1030;
      box-shadow: 2px 0 8px rgba(0,0,0,0.03);
      transition: width 0.2s;
    }
    .sidebar.collapsed {
      width: 60px;
    }
    .sidebar .nav-link {
      color: #333;
      font-weight: 500;
      padding: 12px 24px;
      display: block;
      transition: background 0.2s, padding 0.2s, opacity 0.2s;
    }
    .sidebar .nav-link .sidebar-label {
      display: inline;
    }
    .sidebar.collapsed .nav-link .sidebar-label {
      display: none;
    }
    .sidebar .nav-link i {
      margin-left: 8px;
      font-size: 1.2em;
    }
    .sidebar.collapsed .nav-link {
      text-align: center;
      padding-left: 0;
      padding-right: 0;
    }
    .sidebar.collapsed .nav-link i {
      margin-left: 0;
      font-size: 1.5em;
    }
    .sidebar .nav-link:hover {
      background: #f8f9fa;
      color: #0d6efd;
      text-decoration: none;
    }
    .sidebar-toggle {
      position: absolute;
      top: 10px;
      right: -20px;
      background: #fff;
      border: 1px solid #eee;
      border-radius: 50%;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 1050;
      box-shadow: 0 2px 8px rgba(0,0,0,0.07);
      transition: right 0.2s;
      font-size: 1.5rem;
      color: #333;
    }
    .sidebar-toggle .toggle-icon {
      font-size: 1.5rem;
      font-weight: bold;
      color: #333;
      transition: transform 0.2s;
      display: inline-block;
    }
    .sidebar.collapsed .sidebar-toggle .toggle-icon {
      transform: rotate(180deg);
    }
    @media (max-width: 768px) {
      .sidebar {
        width: 100%;
        height: auto;
        position: static;
        border-right: none;
        box-shadow: none;
        padding-top: 0;
      }
      .sidebar.collapsed {
        width: 100%;
      }
      .main-content {
        margin-left: 0 !important;
      }
    }
    .main-content {
      margin-left: 200px;
      transition: margin-left 0.2s;
    }
  </style>
</head>
<body class="bg-light">
  <!-- Sidebar -->
  <nav class="sidebar d-flex flex-column" id="sidebar">
    <button class="sidebar-toggle" id="sidebarToggle" title="Encolher/Expandir">
      <span class="toggle-icon">&lt;</span>
    </button>
    <a href="/" class="nav-link">
      <span class="sidebar-label">Início</span>
      <i class="fa-solid fa-house-chimney"></i>
    </a>
    <a href="/phelps" class="nav-link">
      <span class="sidebar-label">PHELPS</span>
      <i class="fa-solid fa-person-swimming"></i>
    </a>
    <a href="/logout" class="nav-link">
      <span class="sidebar-label">Sair</span>
      <i class="fa-solid fa-right-from-bracket"></i>
    </a>
  </nav>
  <!-- Main Content -->
  <div class="main-content">
    <div class="container py-5">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card shadow">
            <div class="card-body">
              <h5 class="card-title mb-4 text-center text-black-50">BOT de Cadastro <img src="http://teiacrm.com/images/logo_teiacrm_horizontal.png" class="img-fluid" width="15%" alt=""></h5>
              <span class="text-black-50" style="font-size:x-small">É necessário que a planilha esteja no padrão alinhado com o <b>Team</b></span>
              <form id="form-process" action="/process" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                  <label for="planilha" class="form-label text-black-50">Planilha (.xlsx):</label>
                  <input type="file" class="form-control" id="planilha" name="planilha" required>
                </div>
                <div class="mb-3">
                  <label for="url" class="form-label text-black-50">URL do formulário:</label>
                  <input type="url" class="form-control" id="url" name="url" required placeholder="Link de cadastro loja&gt;equipe">
                </div>
                <button type="submit" class="btn btn-primary w-100">Processar</button>
              </form>

              <!-- Histórico de planilhas processadas -->
              <div class="mt-4">
                <h6 class="text-black-50 mb-2"><i class="fa-solid fa-clock-rotate-left"></i> Histórico de uploads</h6>
                <ul class="list-group" id="historicoUploads">
                  <!-- Preenchido via JS -->
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <footer class="bg-white text-center py-3 mt-5 shadow-sm"
      style="position:fixed;left:0;bottom:0;width:100%;z-index:1040;">
      <div class="container">
        <small class="text-muted text-decoration-none">&copy; 2025 <a href="https://github.com/zzjunior">zzjunior</a></small>
      </div>
    </footer>
  </div>

  <!-- Modal Bootstrap -->
  <div class="modal fade" id="processModal" tabindex="-1" aria-labelledby="processModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="processModalLabel">Resultado do Processamento</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body" id="processModalBody">
          <!-- Conteúdo preenchido via JS -->
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-danger" id="btnStopProcess" style="display:none;">Parar de processar</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const sidebar = document.getElementById('sidebar');
    const sidebarToggle = document.getElementById('sidebarToggle');
    sidebarToggle.addEventListener('click', function() {
      sidebar.classList.toggle('collapsed');
    });

    let isProcessing = false;
    let currentExecutionId = null;
    let progressInterval = null;

    document.getElementById('form-process').addEventListener('submit', handleFormSubmit);

    async function handleFormSubmit(e) {
      e.preventDefault();

      if (isProcessing) {
        console.log('Já está processando, ignorando submit duplicado');
        return;
      }

      isProcessing = true;
      const form = e.target;
      const formData = new FormData(form);

      const modal = new bootstrap.Modal(document.getElementById('processModal'));
      const modalBody = document.getElementById('processModalBody');
      const btnStop = document.getElementById('btnStopProcess');

      btnStop.style.display = 'inline-block';
      modalBody.innerHTML = `
        <div class="text-center mb-3" id="processSpinner">
          <div class="spinner-border"></div>
          <div>Processando...</div>
        </div>
        <div class="progress mb-3">
          <div class="progress-bar" role="progressbar" style="width: 0%" id="progressBarProcess">0%</div>
        </div>
        <div id="statusTextProcess">Preparando...</div>
        <ul class="list-group mt-3" id="processList"></ul>
      `;
      modal.show();

      // Função para atualizar barra de progresso e status
      function atualizarProgressoProcess(progress) {
        const progressBar = document.getElementById('progressBarProcess');
        const spinner = document.getElementById('processSpinner');
        const statusText = document.getElementById('statusTextProcess');
        const processList = document.getElementById('processList');

        if (progressBar) {
          progressBar.style.width = `${progress.progresso || 0}%`;
          progressBar.textContent = `${progress.progresso || 0}%`;
        }
        if (statusText) {
          statusText.textContent = `Processadas: ${progress.processadas || 0}/${progress.total || 0} (${progress.progresso || 0}%)`;
        }
        if (processList && progress.resultados) {
          processList.innerHTML = progress.resultados.map(r =>
            `<li class="list-group-item list-group-item-${r.status === 'sucesso' ? 'success' : 'danger'}">
              Linha ${r.linha}: ${r.nome} - ${r.status === 'sucesso' ? r.mensagem : 'Erro: ' + r.mensagem}
            </li>`
          ).join('');
        }
        // Esconde spinner e porcentagem ao finalizar
        if (progress.status === 'finalizado' || progress.status === 'parado' || progress.status === 'erro') {
          if (spinner) spinner.style.display = 'none';
          if (progressBar) progressBar.style.display = 'none';
          if (statusText) {
            if (progress.status === 'finalizado') {
              statusText.innerHTML =
                `<div class="alert alert-success">Processamento concluído! ${progress.processadas}/${progress.total} linhas processadas.</div>`;
            } else if (progress.status === 'parado') {
              statusText.innerHTML =
                `<div class="alert alert-warning">Processamento interrompido! ${progress.processadas}/${progress.total} linhas processadas.</div>`;
            } else {
              statusText.innerHTML =
                `<div class="alert alert-danger">Erro no processamento: ${progress.erro}</div>`;
            }
          }
        }
      }

      btnStop.onclick = async function() {
        btnStop.disabled = true;
        btnStop.innerText = "Parando...";
        if (currentExecutionId) {
          await fetch(`/process/parar/${currentExecutionId}`, { method: 'POST' });
        }
      };

      try {
        const response = await fetch('/process', {
          method: 'POST',
          body: formData
        });
        const result = await response.json();

        if (result.status === 'iniciado') {
          currentExecutionId = result.executionId;
          document.getElementById('statusTextProcess').textContent = `Processando ${result.total} linhas...`;

          progressInterval = setInterval(async () => {
            try {
              const progressResponse = await fetch(`/process/progresso/${currentExecutionId}`);
              const progress = await progressResponse.json();

              if (progress.status === 'nao_encontrado') {
                clearInterval(progressInterval);
                return;
              }

              atualizarProgressoProcess(progress);

              if (progress.status === 'finalizado' || progress.status === 'parado' || progress.status === 'erro') {
                clearInterval(progressInterval);
                progressInterval = null;
                btnStop.style.display = 'none';
                isProcessing = false;
                // Salva no histórico
                const nomeArquivo = document.getElementById('planilha').files[0]?.name || 'Planilha';
                salvarHistorico(nomeArquivo, formData);
              }
            } catch (err) {
              console.error('Erro ao verificar progresso:', err);
            }
          }, 2000);

        } else {
          btnStop.style.display = 'none';
          modalBody.innerHTML = `<div class="alert alert-danger">Erro ao iniciar: ${result.mensagem}</div>`;
          isProcessing = false;
        }
      } catch (err) {
        btnStop.style.display = 'none';
        modalBody.innerHTML = `<div class="alert alert-danger">Erro ao processar: ${err.message}</div>`;
        isProcessing = false;
      }
    }

    // Funções do histórico
    function carregarHistorico() {
      const historico = JSON.parse(localStorage.getItem('historicoUploads') || '[]');
      const ul = document.getElementById('historicoUploads');
      ul.innerHTML = '';
      if (historico.length === 0) {
        ul.innerHTML = '<li class="list-group-item text-muted">Nenhuma planilha processada ainda.</li>';
      } else {
        historico.forEach((item, idx) => {
          ul.innerHTML += `
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span>
                <i class="fa-solid fa-file-excel text-success"></i>
                <b>${item.nomeArquivo}</b>
                <small class="text-muted ms-2">${item.dataHora || ''}</small>
              </span>
              <button class="btn btn-outline-primary btn-sm" onclick="processarNovamente(${idx})">
                <i class="fa-solid fa-rotate-right"></i> Processar novamente
              </button>
            </li>
          `;
        });
      }
    }

    function salvarHistorico(nomeArquivo, formData) {
      const historico = JSON.parse(localStorage.getItem('historicoUploads') || '[]');
      historico.unshift({
        nomeArquivo,
        dataHora: new Date().toLocaleString(),
        formData: Object.fromEntries(formData.entries())
      });
      localStorage.setItem('historicoUploads', JSON.stringify(historico.slice(0, 10)));
      carregarHistorico();
    }

    window.processarNovamente = function(idx) {
      const historico = JSON.parse(localStorage.getItem('historicoUploads') || '[]');
      const item = historico[idx];
      if (!item) return;
      document.getElementById('url').value = item.formData.url || '';
      alert('Para processar novamente, envie a planilha novamente.');
    };

    carregarHistorico();
  </script>
</body>
</html>